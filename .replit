modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["imagemagick", "libwebp"]

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "build.sh"]
run = ["bash", "start.sh"]

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash dev-start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
integrations = ["javascript_mem_db:1.0.0", "javascript_openai_ai_integrations:1.0.0", "google-mail:1.0.0", "stripe:1.0.0", "javascript_log_in_with_replit:1.0.0", "resend:1.0.0", "javascript_stripe:1.0.0"]

[userenv]

[userenv.shared]
ADMIN_EMAILS = "webiq.co@gmail.com,info@webiq.co,hello@boisecabinet.co,hello@boiseremodeling.co,hello@p5homeco.com,hello@boisehandyman.co"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY = "pk_live_51LGm9XKmgtIDVx8lrH27gaoWAdwf1F0O7Gxx2RkNqICfBvPslxV7IJCdufiFDHnNxaCKgr3IcOZokNdmNaxy3z6z000ipOzjOv"
NODE_OPTIONS = "--max-old-space-size=1536"
# Boise Handyman Co's own GA4 property: "Websites (BRC, BCC, REC, ASOS)"
# account 396104300, property 549906676, web stream 15437749728. Read from
# the GA admin data-stream page 2026-09-03. Never G-NGE449QF9Y (Remodeling).
NEXT_PUBLIC_GA_MEASUREMENT_ID = "G-4WQQ639LR1"
NEXT_PUBLIC_META_PIXEL_ID = "2461987544292871"

[userenv.development]
P5_OBJECT_STORAGE_ENABLED = "true"
P5_SCOPE_OPENAI_MODEL = "gpt-4.1"

[userenv.production]
P5_OBJECT_STORAGE_ENABLED = "true"
P5_SCOPE_OPENAI_MODEL = "gpt-4.1"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 5000
externalPort = 80

[objectStorage]
defaultBucketID = "replit-objstore-5d123ebc-ef31-487a-8680-86cb9ef1f0d5"
